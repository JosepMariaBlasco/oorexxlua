# shell scripts keep LF line endings on every checkout (bash on Windows)
*.sh text eol=lf
# the fixes for ooRexx apply byte for byte (scripts/setup-oorexx.sh)
*.diff -text

# Rexx code is Rexx for GitHub's language detection (oorexx-bridges CONVENTIONS.md)
*.cls       linguist-language=REXX
*.testGroup linguist-language=REXX
