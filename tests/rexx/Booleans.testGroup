#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Booleans.testGroup: .LogicalWrapper (ooRexx's logicalwrapper.cls, r13278,  */
/* RFE #880: the family's boolean class) and Lua's booleans (docs/design.md, */
/* *Values*; oorexx-bridges topics/booleans.md).                              */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Booleans.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'
::requires 'json.cls'

::class "Booleans.testGroup" subclass LuaTestCase public

-- ooRexx's class, required by lua.cls: no copy of the bridge's, no entry in
-- .environment or .local, no .Boolean
::method test_the_class_is_ooRexxs
  self~assertSame("LogicalWrapper", .LogicalWrapper~id)
  self~assertFalse(.environment~hasEntry("BOOLEAN"), "no .Boolean")
  self~assertFalse(.environment~hasEntry("LOGICALWRAPPER"))
  self~assertFalse(.local~hasEntry("LUA.BOOLEAN"))

::method test_Lua_booleans_are_LogicalWrappers
  t = .lua~eval("return true"); f = .lua~eval("return false")
  self~assertSame(.LogicalWrapper~true, t)
  self~assertSame(.LogicalWrapper~false, f)
  self~assertTrue(t, "IF works")
  self~assertTrue(t = 1 & f = 0 & t == "1", "as 1 and 0")
  r = .lua~eval("return 1 < 2, nil, false")
  self~assertSame(.LogicalWrapper~true, r)
  a = .lua~eval("function() return true, nil, false end")~callAll
  self~assertSame(.LogicalWrapper~false, a[3])

::method test_LogicalWrappers_are_Lua_booleans
  self~assertSame("boolean true", .lua~eval("return type(...) .. ' ' .. tostring(...)", .LogicalWrapper~true))
  self~assertSame("boolean false", .lua~eval("return type(...) .. ' ' .. tostring(...)", .LogicalWrapper~false))
  self~assertSame("boolean false", .lua~eval("return type(...) .. ' ' .. tostring(...)", .LogicalWrapper~of(1 > 2)))
  self~assertSame("number", .lua~eval("return math.type(...) and 'number'", .true), ".true is the string 1")
  -- in a table, as an Array item
  self~assertSame("boolean", .lua~eval("return type((...)[2])", .array~of(1, .LogicalWrapper~false)))
  -- a subclass's instances too
  self~assertSame("boolean", .lua~eval("return type(...)", .JsonLike~true))

-- json.cls's booleans are LogicalWrappers (JsonBoolean, a subclass): they
-- reach Lua as booleans with no code for JSON
::method test_json_booleans_are_Lua_booleans
  self~assertSame("boolean true", .lua~eval("return type(...) .. ' ' .. tostring(...)", .json~true))
  self~assertSame("boolean false", .lua~eval("return type(...) .. ' ' .. tostring(...)", .json~false))
  d = .json~fromJSON('{"on": true, "off": false, "n": 1}')
  self~assertSame("boolean boolean number", .lua~eval("local d = ...; return type(d:at('on')) .. ' ' .. type(d:at('off')) .. ' ' .. type(d:at('n'))", d))

::method test_the_aliases
  self~assertSame(.LogicalWrapper~true, .lua~true)
  self~assertSame(.LogicalWrapper~false, .lua~false)
  s = .LuaState~new
  self~assertSame(.LogicalWrapper~true, s~true, "of any state")
  s~close
  -- ~box("boolean", ...) stays a .LuaObject, a Lua value of that type
  b = .lua~box("boolean", 0)
  self~assertTrue(b~isA(.LuaObject))
  self~assertSame("boolean", b~luaType)

::method test_round_trips
  self~assertSame(.LogicalWrapper~false, .lua~eval("return ...", .LogicalWrapper~false))
  self~assertSame(.LogicalWrapper~true, .lua~eval("return ...", .json~true), "a JsonBoolean comes back as the class's own")
  self~assertSame("boolean", .lua~eval("local f = ...; return type(f(false))", .routine~new("id", "return arg(1)")))

::method test_a_routine_returning_a_LogicalWrapper_sorts
  less = .routine~new("less", "return .LogicalWrapper~of(arg(1) < arg(2))")
  w = .lua~table(.array~of(3, 1, 2))
  .lua~global("table")~sort(w, less)
  self~assertSame("1,2,3", .lua~global("table")~concat(w, ","))
  w = .lua~table(.array~of(3, 1, 2))
  .lua~global("table")~sort(w, .lua~predicate(less))
  self~assertSame("1,2,3", .lua~global("table")~concat(w, ","), "and through predicate")

::class JsonLike subclass LogicalWrapper
