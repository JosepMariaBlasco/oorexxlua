#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Threads.testGroup: several Rexx threads in one Lua at once, with           */
/* callbacks into Rexx (docs/design.md, *Threads*): the state's lock          */
/* serializes them; and threads with states of their own.                     */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Threads.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "Threads.testGroup" subclass LuaTestCase public

::method test_threads_in_one_state
  threads = 8; n = 2000
  s = .LuaState~new
  s~eval("counter = 0; function bump(f, i) counter = counter + 1; return f(i) end")
  twice = .routine~new("twice", "return arg(1) * 2")
  done = .queue~new
  do t = 1 to threads
    .Worker~new~run(s, n, twice, done)
  end
  self~assertTrue(waitAll(done, threads), "every thread got the right results")
  self~assertEquals(threads * n, s~global("counter"), "every call ran once")
  s~close

::method test_threads_with_states_of_their_own
  threads = 8; n = 2000
  done = .queue~new
  do t = 1 to threads
    .Worker~new~own(n, done)
  end
  self~assertTrue(waitAll(done, threads), "every thread got the right results")

-- ~table of a fresh number on many threads: before ooRexx r13286 (bug #2122)
-- IsInstanceOf asked of a number with no string value made that string
-- without the kernel lock, corrupting ooRexx's heap: without the fix (or the
-- bridge's old workaround) it crashed or hung 5 runs of 5
::method test_table_of_fresh_numbers_on_threads
  threads = 8
  done = .queue~new
  do t = 1 to threads
    .Worker~new~tables(2000, done)
  end
  self~assertTrue(waitAll(done, threads), "every thread got its tables")

-- A Rexx object that only a Lua userdata holds, as a method's result, while
-- other threads use the same state and Lua collects at nearly every
-- allocation: Lua may finalize the userdata as soon as the method has left
-- the state, before ooRexx has the result (oorexx-bridges, lesson 5).
-- Without toResult it crashed 5 runs of 10 (4 threads, 2,000 rounds).
::method test_rexx_objects_returned_while_threads_collect
  threads = 4
  s = .LuaState~new
  s~eval("if _VERSION == 'Lua 5.3' then collectgarbage('setpause', 0); collectgarbage('setstepmul', 1000)" -
         "else collectgarbage('incremental', 0, 1000) end")
  s~eval("mk = ...", .routines~mk)
  s~eval("function fresh(i) local o = mk(i); local j = {} for k = 1, 8 do j[k] = {k} end return o end")
  done = .queue~new
  do t = 1 to threads
    .Worker~new~fresh(s, 3000, done)
  end
  self~assertTrue(waitAll(done, threads), "every thread got its objects")
  s~close

::routine mk                -- a fresh object: only Lua holds it once it is returned
  use arg i
  return .Fresh~new(i)

::class Fresh
::attribute id
::method init; expose id; use arg id

::routine waitAll           -- the results of all the threads (a Queue's pull does not wait)
  use arg done, threads
  do while done~items < threads; call SysSleep 0.01; end
  ok = 1
  do t = 1 to threads; ok = ok & done~pull; end
  return ok

::class Worker
::method run
  use arg s, n, twice, done
  reply
  bump = s~global("bump")
  ok = 1
  do i = 1 to n
    if bump~call(twice, i) <> 2 * i then ok = 0
  end
  done~queue(ok)
::method own
  use arg n, done
  reply
  s = .LuaState~new
  s~eval("function sq(x) return x * x end")
  sq = s~global("sq")
  ok = 1
  do i = 1 to n
    if sq~call(i) <> i * i then ok = 0
  end
  s~close
  done~queue(ok)
::method tables
  use arg n, done
  reply
  s = .LuaState~new
  ok = 1
  do i = 1 to n
    if s~table(i * 7 / 3)~luaType \== "table" then ok = 0      -- a number with no string value yet
    if s~table(i + 0.5)~luaType \== "table" then ok = 0
  end
  s~close
  done~queue(ok)
::method fresh
  use arg s, n, done
  reply
  fresh = s~global("fresh")
  ok = 1
  do i = 1 to n
    junk = .array~new(50)~fill(i)           -- Rexx allocates too
    o = s~eval("return fresh(...)", i)
    if \o~isA(.Fresh) then ok = 0; else if o~id \= i then ok = 0
    o = fresh~call(-i)
    if \o~isA(.Fresh) then ok = 0; else if o~id \= -i then ok = 0
  end
  done~queue(ok)
