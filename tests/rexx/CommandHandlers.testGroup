#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* CommandHandlers.testGroup: ADDRESS environments written in Lua             */
/* (docs/design.md, *Command environments*; oorexx-bridges,                   */
/* topics/command-handlers.md, rule 6): a .LuaCommandHandler (a core          */
/* .CommandHandler, ooRexx r13288) registered with .CommandHandler~register;  */
/* handler(command, caller), caller the core's .CommandContext; RC its value, */
/* whatever its sign; a Lua error is SYNTAX 98.900; stacking, deregister and  */
/* their errors are the core's.                                               */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.CommandHandlers.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "CommandHandlers.testGroup" subclass LuaTestCase public

-- handler(src): a Lua function from its source, in .lua
::method handler
  use strict arg src
  return .lua~eval("return function(command, ctx)" src "end")

-- reg(name, src or a .LuaObject): registered with the core; what it covers
::method reg
  use strict arg name, h
  if \h~isA(.LuaObject) then h = self~handler(h)
  return .CommandHandler~register(name, .lua~commandHandler(h))

::method unreg
  use strict arg name
  return .CommandHandler~deregister(name)

::method test_rc_is_the_value_whatever_its_sign
  self~reg("RCT", "return load('return ' .. command)()")
  signal on error name wrong
  signal on failure name wrong
  address rct
  '0';      self~assertEquals(0, rc)
  '5';      self~assertEquals(5, rc, "positive: just RC")
  '-3';     self~assertEquals(-3, rc, "negative: just RC")
  'nil';    self~assertEquals(0, rc, "nil: 0")
  '"abc"';  self~assertSame("abc", rc)
  '2^10';   self~assertSame("1024.0", rc, "a float, by the conversion rules")
  self~unreg("RCT")
  self~reg("RCT", "local x = 1")
  address rct 'anything'
  self~assertEquals(0, rc, "no value: 0")
  self~unreg("RCT")
  return
wrong:
  self~fail("the RC's sign raised" condition("C"))

::method test_command_is_a_lua_string
  self~reg("ECHO", "echoed = {type(command), command, ctx:environment()}")
  address echo 1 + 1
  self~assertSame("string", .lua~eval("return echoed[1]"), "a string, even when it looks like a number")
  self~assertSame("2", .lua~eval("return echoed[2]"), "the command as Rexx evaluated it")
  self~assertSame("ECHO", .lua~eval("return echoed[3]"))
  address echo 'a' || '00'x || 'b'
  self~assertEquals(3, .lua~eval("return #echoed[2]"), "a NUL is kept")
  address value 'echo'
  ''
  self~assertSame("echo", .lua~eval("return echoed[3]"), "names are found in any case")
  self~unreg("ECHO")
  .lua~eval("echoed = nil")

-- the core's register: a second handler stacks, and gives back the one it
-- covers; deregister gives back the one it removed, and the one below answers
::method test_stacking
  self~assertSame(.nil, self~reg("calc", "return 1"), "nothing covered")
  address calc 'x'
  self~assertEquals(1, rc)
  covered = self~reg("CALC", "return 2")
  self~assertSame("LUACOMMANDHANDLER", covered~class~id)
  self~assertSame("function", covered~handler~luaType)
  address calc 'x'
  self~assertEquals(2, rc, "the newest answers")
  self~assertEquals(2, .CommandHandler~handlers("CALC")~items)
  removed = self~unreg("Calc")
  self~assertSame("LUACOMMANDHANDLER", removed~class~id)
  address calc 'x'
  self~assertEquals(1, rc, "the one below again")
  self~unreg("CALC")
  self~assertSame(.nil, .CommandHandler~handler("CALC"))

-- a Lua handler and one written in Rexx stack on each other either way
::method test_with_a_rexx_handler
  self~reg("MIX", "return 1")
  .CommandHandler~register("MIX", .RexxHandler~new)
  address mix 'abc'
  self~assertEquals(1003, rc)
  self~unreg("MIX")
  address mix 'abc'
  self~assertEquals(1, rc, "the Lua one below")
  self~unreg("MIX")
  .CommandHandler~register("MIX", .RexxHandler~new)
  self~reg("MIX", "return 2")
  address mix 'abc'
  self~assertEquals(2, rc)
  self~unreg("MIX")
  address mix 'abc'
  self~assertEquals(1003, rc, "the Rexx one below")
  self~unreg("MIX")

-- over ADDRESS LUA (the bridge's own, a native one): stacks, as over any
::method test_over_address_lua
  self~reg("LUA", "return 9")
  address lua 'whatever'
  self~assertEquals(9, rc)
  removed = self~unreg("LUA")
  self~assertSame("LUACOMMANDHANDLER", removed~class~id)
  address lua 'return 6 * 7'
  self~assertEquals(42, result, "ADDRESS LUA back")

-- and the other way round: a LUA registered before lua.cls is loaded stays
-- under the bridge's (StackCommandEnvironment, r13297; AddCommandEnvironment
-- replaced it).  In an instance of its own: lua-over-registered.rex
::method test_lua_cls_stacks_over_a_registered_lua
  dir = .File~new(.context~package~name)~parent
  out = self~outputOf(dir, .File~new("lua-over-registered.rex", dir)~absolutePath)
  self~assertSame("before: 1000|loaded: 0 42|deregistered: 1000|unknown: 30", out~makeString("L", "|"))

::method test_variables
  self~reg("VARS", -
    "got = {ctx:getVar('x'), ctx:getVar('a.i'), ctx:getVar('A.2'), ctx:hasVar('nothing')}" -
    "ctx:setVar('y', 42); ctx:setVar('a.i', 'set')" -
    "ctx:setVar('t', {1, 2}); ctx:setVar('b', true); ctx:dropVar('gone')")
  x = "3.10"; i = 2; a.2 = "two"; gone = 1
  address vars 'x'
  self~assertSame("3.10", .lua~eval("return got[1]"), "by the conversion rules")
  self~assertSame("two", .lua~eval("return got[2]"), "a compound name: its tail resolved in the caller")
  self~assertSame("two", .lua~eval("return got[3]"))
  self~assertEquals(0, .lua~eval("return got[4]"), "hasVar: the core's 0 (a number in Lua)")
  self~assertEquals(42, y)
  self~assertSame("set", a.2)
  self~assertSame("LUAOBJECT", t~class~id)
  self~assertEquals(2, t[2])
  self~assertTrue(b~isA(.LogicalWrapper))
  self~assertFalse(var("GONE"))
  self~unreg("VARS")
  .lua~eval("got = nil")

-- the core's raise: ERROR and FAILURE after the command, with their RC
::method test_raise_error_and_failure
  self~reg("RAISE", -
    "local kind, rc = command:match('(%a+) (%S+)')" -
    "rc = tonumber(rc)" -
    "if kind == 'error' then return ctx:raiseError(rc) elseif kind == 'failure' then return ctx:raiseFailure(rc)" -
    "elseif kind == 'raise' then return ctx:raise('ERROR', rc, 'described') end")
  address raise
  signal on error
  'error 3'
  self~fail("no ERROR")
error:
  self~assertSame("ERROR", condition("C"))
  self~assertEquals(3, rc)
  signal on failure
  'failure -4'
  self~fail("no FAILURE")
failure:
  self~assertSame("FAILURE", condition("C"))
  self~assertEquals(-4, rc)
  signal on error name error2
  'raise 5'
  self~fail("no ERROR")
error2:
  self~assertEquals(5, rc)
  self~assertSame("described", condition("D"))
  signal off error
  'error 9'                                 -- not trapped: just RC
  self~assertEquals(9, rc)
  self~unreg("RAISE")

::method test_lua_error_is_syntax_98_900
  self~reg("BAD", "if command == 'table' then error({code = 42}) end error('boom: ' .. command)")
  signal on syntax
  address bad 'x'
  self~fail("no SYNTAX")
syntax:
  c = condition("O")
  self~assertSame("98.900", c~code)
  self~assertTrue(c~additional[1]~pos("Lua error:") = 1, c~additional[1])
  self~assertTrue(c~additional[1]~pos("boom: x") > 0)
  self~assertTrue(c~additional[2]~pos("boom: x") > 0, "[2] the error value")
  self~assertTrue(c~additional[3]~pos("stack traceback:") = 1, "[3] Lua's traceback")
  signal on syntax name syntax2
  address bad 'table'
  self~fail("no SYNTAX")
syntax2:
  c = condition("O")
  self~assertSame("98.900", c~code)
  self~assertEquals(42, c~additional[2]~code, "a value that is not a string: a .LuaObject")
  self~unreg("BAD")

::method test_rexx_error_through_lua_is_itself
  self~reg("THROUGH", .lua~eval("local o = ...; return function() return o:boom() end", .Boom~new))
  signal on syntax
  address through 'x'
  self~fail("no SYNTAX")
syntax:
  self~assertSame("41.1", condition("O")~code, "the Rexx error, itself")
  self~unreg("THROUGH")

-- with its DESCRIPTION (a workaround: see Errors.testGroup)
::method test_rexx_error_through_lua_keeps_its_description
  self~reg("THROUGH", .lua~eval("local o = ...; return function() return o:boom() end", .Boom3~new))
  signal on syntax
  address through 'x'
  self~fail("no SYNTAX")
syntax:
  c = condition("O")
  self~unreg("THROUGH")
  self~assertSame("40.1", c~code)
  self~assertSame("the description", c~description)

-- without WITH, the core's context has no output (rule 6: the core is the
-- reference); the handler asks isRedirected first, and writes to .output
::method test_output_without_with
  self~reg("SAY", -
    "local r = ctx:isRedirected('Output')" -
    "local ok = pcall(function() return ctx:output() end)" -
    "said = {r, ok}" -
    "return 0")
  address say 'hello'
  self~assertEquals(0, .lua~eval("return said[1]"), "not redirected: the core's 0")
  self~assertFalse(.lua~eval("return said[2]"), "output() without WITH OUTPUT: an error, the core's")
  self~unreg("SAY")
  .lua~eval("said = nil")

::method test_with
  self~reg("UP", -
    "local i, o = ctx:input(), ctx:output()" -
    "o:lineout('first ' .. i:linein())" -
    "while i:lines() == 1 do o:lineout(i:linein():upper()) end" -
    "ctx:error():lineout('done')" -
    "return ctx:isRedirected('Input') .. ctx:isRedirected('Output') .. ctx:isRedirected('Error')")
  in.0 = 3; in.1 = "a"; in.2 = "b"; in.3 = "c"
  address up 'x' with input stem in. output stem out. error stem err.
  self~assertSame("111", rc)
  self~assertEquals(3, out.0)
  self~assertSame("first a", out.1)
  self~assertSame("B", out.2)
  self~assertSame("C", out.3)
  self~assertEquals(1, err.0)
  self~assertSame("done", err.1)
  self~unreg("UP")

-- rule 1 for any condition (oorexx-bridges, topics/command-handlers.md): a
-- Rexx method that the handler calls raises USER X, and the code that issued
-- the command traps it, itself.  (Not yet from a Rexx Routine: ooRexx drops
-- the condition at CallRoutine, #2123.)
::method test_a_user_condition_comes_back_as_itself
  self~reg("RAISES", .lua~eval("local o = ...; return function() return o:boom() end", .Boom2~new))
  signal on user x
  address raises 'x'
  self~fail("no USER X")
x:
  c = condition("O")
  self~assertSame("USER X", c~condition)
  self~assertSame("d", c~description)
  self~assertSame("a", c~additional)
  self~unreg("RAISES")

-- the same under ::OPTIONS ERROR SYNTAX: still USER X (#2119, fixed in r13282)
::method test_a_user_condition_under_options_error_syntax
  self~reg("RAISES2", .lua~eval("local o = ...; return function() return o:boom() end", .Boom2~new))
  r = .routine~new("r", .array~of("signal on user x", "signal on syntax", "address raises2 'go'", -
      "return 'nothing'", "x: return 'USER' condition('o')~description", -
      "syntax: return 'SYNTAX' condition('o')~code", "::options error syntax"))
  self~assertSame("USER d", r~call)
  self~unreg("RAISES2")

-- rule 1 for any condition, from a Rexx Routine (CallRoutine): needs ooRexx
-- #2123 (r13320: the condition kept for the native caller); the bridge raises
-- it again with RaiseCondition, with its description, additional and result
::method routineRaiser
  return .routine~new("r", 'raise user x description "d" additional ("a") return 7')

::method test_a_user_condition_from_a_routine_through_a_handler
  self~reg("RAISESR", .lua~eval("local f = ...; return function() return f() end", self~routineRaiser))
  signal on user x
  address raisesr 'x'
  self~fail("no USER X")
x:
  c = condition("O")
  self~assertSame("USER X", c~condition)
  self~assertSame("d", c~description)
  self~assertSame("a", c~additional)
  self~assertSame(7, c~result, "the routine's value (a workaround: plain Rexx has no RESULT)")
  self~unreg("RAISESR")

::method test_a_user_condition_from_a_routine_through_eval
  signal on user x
  .lua~eval("local f = ...; return f()", self~routineRaiser)
  self~fail("no USER X")
x:
  c = condition("O")
  self~assertSame("USER X", c~condition)
  self~assertSame("d", c~description)
  self~assertSame("a", c~additional)
  self~assertSame(7, c~result, "the routine's value (a workaround: plain Rexx has no RESULT)")

-- under ::OPTIONS ERROR SYNTAX: this one comes back by RaiseCondition, so it
-- is where #2119 (fixed in r13282) would have mattered
::method test_a_user_condition_from_a_routine_under_options_error_syntax
  self~reg("RAISESR2", .lua~eval("local f = ...; return function() return f() end", self~routineRaiser))
  r = .routine~new("r", .array~of("signal on user x", "signal on syntax", "address raisesr2 'go'", -
      "return 'nothing'", "x: return 'USER' condition('o')~description", -
      "syntax: return 'SYNTAX' condition('o')~code", "::options error syntax"))
  self~assertSame("USER d", r~call)
  self~unreg("RAISESR2")

-- the other conditions, from a Routine, through eval and through a handler,
-- trapped by SIGNAL ON: condition, description and additional as in plain
-- Rexx (ERROR's and FAILURE's RC cannot come back yet: RaiseCondition has
-- no RC; topics/command-handlers.md, rule 1, "The RC waits for ooRexx")
::method test_other_conditions_from_a_routine
  s = .LuaState~new
  do cond over .array~of("NOTREADY", "ERROR", "FAILURE")
    raiser = .routine~new("r", "raise" cond (cond = "NOTREADY")~?("", 5) -
      "description 'd" cond"' additional ('a') return 7")
    c = trapOf(cond, s, "local f = ...; return f()", raiser)
    self~assertSame(cond, c~condition, cond "through eval")
    self~assertSame("d" cond, c~description, cond "through eval")
    self~assertSame("a", c~additional, cond "through eval")
    .CommandHandler~register("RAISESR3", s~commandHandler(s~eval("local f = ...; return function() return f() end", raiser)))
    c = trapOf(cond, "RAISESR3")
    .CommandHandler~deregister("RAISESR3")
    self~assertSame(cond, c~condition, cond "through a handler")
    self~assertSame("d" cond, c~description, cond "through a handler")
    self~assertSame("a", c~additional, cond "through a handler")
  end
  s~close

-- untrapped, or under CALL ON, the call gives the routine's value (RAISE ...
-- RETURN 7), as in plain Rexx; not Error 91.  A workaround in
-- pushRexxCondition (oorexx-bridges oorexx-bugs/raise-return-value/): the
-- value is the condition's RESULT, which plain Rexx does not have
::method test_a_condition_untrapped_or_under_call_on_gives_the_value
  raiser = .routine~new("r", "raise user x description 'd' additional ('a') return 7")
  self~assertSame(7, .lua~eval("local f = ...; return f()", raiser), "untrapped")
  self~assertSame(7, callOnValue(raiser), "under CALL ON")
  self~assertSame("d", .local~lua.test.handled, "and the handler ran")
  .CommandHandler~register("RAISESR4", .lua~commandHandler(.lua~eval("local f = ...; return function() return f() end", raiser)))
  address raisesr4 'x'
  .CommandHandler~deregister("RAISESR4")
  self~assertEquals(7, rc, "a handler: RC is the value, untrapped")

-- a DESCRIPTION that is not a String comes back as it was (RAISE takes any
-- object; DecodeConditionInfo gives only Strings)
::method test_a_description_that_is_not_a_string
  d = .object~new                       -- crosses Lua as itself (an Array would be a table)
  raiser = .routine~new("r", "use arg d; raise user x description (d) additional ('a') return 7")
  c = trapOf("USER X", .lua, "local f, d = ...; return f(d)", raiser, d)
  self~assertSame("USER X", c~condition)
  self~assertSame(d, c~description, "the same object")

-- a SIGNAL ON in the issuer for a condition that a Rexx method raises, sent
-- from the Lua handler on the context Rexx handed it: the SIGNAL unwinds
-- through Lua's frames, which the bridge catches and gives back (docs/
-- design.md, *Errors*: SIGNAL past Lua). oorexx-bridges, lesson 4 of
-- 25/10/2026 (on .NET the process ended); every condition, many times
::method test_a_signal_through_lua_for_any_condition
  self~reg("SIG", .lua~eval("local o = ...; return function(cmd) return o[cmd](o) end", .Raiser~new))
  do kind over .array~of("HALT", "USER", "NOTREADY", "ERROR", "FAILURE")
    n = 0
    do i = 1 to 100; n += signalThrough(kind); end
    self~assertEquals(100, n, kind "trapped by SIGNAL ON every time")
  end
  self~assertEquals(0, .lua~eval("return select('#', ...)"), "Lua's stack as it was")
  self~unreg("SIG")

-- a HALT in Rexx code the Lua handler called (host code): a HALT again for
-- the issuer (rule 1, the user, 21/10/2026; kept by rule 6 for host code),
-- as a real Ctrl-C: SIGNAL ON HALT, CALL ON HALT (after the command, RC 1),
-- untrapped SYNTAX 4.1
::method haltHandler
  self~reg("HALTS", .lua~eval("local f = ...; return function() f(); return 5 end", -
    .routine~new("h", "raise halt")))

::method test_a_halt_through_a_handler_signal_on
  self~haltHandler
  signal on halt
  address halts 'x'
  self~fail("no HALT")
halt:
  self~assertSame("HALT", condition("C"))
  self~unreg("HALTS")

::method test_a_halt_through_a_handler_call_on
  self~haltHandler
  self~halted = 0
  call on halt name h
  address halts 'x'
  self~assertEquals(1, rc, "RC 1, as ADDRESS LUA after a Ctrl-C")
  self~assertEquals(1, self~halted, "CALL ON HALT ran")
  self~unreg("HALTS")
  return
h:
  self~halted += 1
  return
::attribute halted

::method test_a_halt_through_a_handler_untrapped
  self~haltHandler
  signal on syntax
  address halts 'x'
  self~fail("no SYNTAX")
syntax:
  self~assertEquals(4.1, condition("O")~code)
  self~unreg("HALTS")

-- the core's context, after its command: isValid 0, its methods an error
::method test_ctx_after_the_command
  self~reg("KEEP", "kept = ctx")
  address keep 'x'
  self~assertEquals(0, .lua~eval("return kept:isValid()"))
  self~assertFalse(.lua~eval("return (pcall(kept.getVar, kept, 'X'))"), "getVar: an error")
  self~unreg("KEEP")
  .lua~eval("kept = nil")

::method test_nested_commands
  self~reg("INNER", "ctx:setVar('INNERRAN', command); return 3")
  self~reg("OUTER", -
    "local rexx = require 'oorexx'" -
    "local rc = rexx.routine(""address inner 'from outer'; return rc"")()" -
    "ctx:setVar('OUTERRAN', rc); return rc + 1")
  address outer 'x'
  self~assertEquals(4, rc)
  self~assertEquals(3, outerRan, "the outer ctx is still good after the inner command")
  self~unreg("INNER")
  self~unreg("OUTER")

-- the core's errors: deregister of a name with no handler, register of .nil
::method test_the_cores_errors
  self~assertSame("93.900", self~codeOf(.CommandHandler, "deregister", "NeverThere"))
  self~assertSame("93.900", self~codeOf(.CommandHandler, "register", "X", .nil))
  self~reg("TWICE2", "return 0")
  self~unreg("TWICE2")
  self~assertSame("93.900", self~codeOf(.CommandHandler, "deregister", "twice2"), "removed already")
  signal on failure
  address twice2 'y'
  self~fail("no FAILURE")
failure:
  self~assertEquals(30, rc, "no handler: as an unknown environment")

-- what is not a Lua callable is no handler: SYNTAX 93.900
::method test_wrong_handlers
  self~assertSame("93.900", self~codeOf(.lua, "commandHandler", .nil))
  self~assertSame("93.900", self~codeOf(.lua, "commandHandler", "a string"))
  self~assertSame("93.900", self~codeOf(.lua, "commandHandler", .lua~eval("return {}")), "a table without __call")
  self~assertSame("93.900", self~codeOf(.LuaCommandHandler, "new", .array~new))
  self~assertTrue(self~errorOf(.lua, "commandHandler", .nil)~pos("handler must be") > 0)
  self~assertSame("97.1", self~codeOf(.lua, "addCommandEnvironment", "X", self~handler("return 0")), "retired")

::method test_callable_table
  self~reg("CALLT", .lua~eval("return setmetatable({}, {__call = function(self, command) return #command end})"))
  address callt 'abcd'
  self~assertEquals(4, rc)
  self~unreg("CALLT")

::method test_handler_runs_in_its_own_state
  s = .LuaState~new
  self~reg("OTHER", s~eval("return function(command) where = command; return 0 end"))
  address other 'here'
  self~assertSame("here", s~global("where"))
  self~assertSame(.nil, .lua~global("where"))
  s~close
  signal on syntax
  address other 'again'
  self~fail("no SYNTAX")
syntax:
  self~assertSame("98.900", condition("O")~code)
  self~assertTrue(condition("O")~message~pos("closed") > 0, condition("O")~message)
  self~unreg("OTHER")

::method test_another_rexx_thread
  self~reg("TWICE", "return tonumber(command) * 2")
  done = .queue~new
  do t = 1 to 4
    .Addresser~new~run("TWICE", 500, done)
  end
  self~assertTrue(waitAll(done, 4), "every thread got the right RCs")
  self~unreg("TWICE")

-- Names registered on one thread while others address names (#2111, #2112)
::method test_registering_while_threads_address
  h = self~handler("return tonumber(command) + 1")
  self~reg("STRESS0", h)
  done = .queue~new
  threads = 8
  do t = 1 to threads
    .Addresser~new~stress(threads, done)
  end
  do k = 1 to 40
    self~reg("STRESS" || k, h)
    call SysSleep 0.002
  end
  self~assertTrue(waitAll(done, threads), "every thread got the right RCs")
  do k = 0 to 40; self~unreg("STRESS" || k); end

-- codeOf(receiver, messageName [, args...]): the code of the SYNTAX condition
-- the message raises
::method codeOf
  use strict arg receiver, name, ...
  args = arg(3, "A")
  signal on syntax
  .message~new(receiver, name, "A", args)~send
  return "no SYNTAX"
syntax:
  return condition("O")~code

::routine signalThrough     -- 1 if the SIGNAL ON for kind trapped what the handler's method raised
  use arg kind
  trap = kind; if kind == "USER" then trap = "USER X"
  interpret "signal on" trap "name trapped"
  address sig kind
  return 0
trapped: return 1

-- the condition object of the condition named cond that running target
-- raises: target~eval(code, args...) for a LuaState, else ADDRESS target
::routine callOnValue        -- .lua~eval of raiser() under CALL ON USER X
  use arg raiser
  .local~lua.test.handled = .nil
  call on user x name handled
  return .lua~eval("local f = ...; return f()", raiser)
handled:
  .local~lua.test.handled = condition("D")
  return

::routine trapOf
  use arg cond, target, code, ...
  signal on notready; signal on error; signal on failure; signal on user x
  if target~isA(.String) then address value target
  if target~isA(.String) then 'go'
  else .message~new(target, "EVAL", "A", arg(1, "A")~section(3))~send
  return .nil
notready: error: failure: x:
  return condition("O")

::routine waitAll           -- the results of all the threads (a Queue's pull does not wait)
  use arg done, threads
  do while done~items < threads; call SysSleep 0.01; end
  ok = 1
  do t = 1 to threads; ok = ok & done~pull; end
  return ok

::class Addresser
::method run
  use arg name, n, done
  reply
  ok = 1
  address value name
  do i = 1 to n
    '' i
    if rc <> 2 * i then ok = 0
  end
  done~queue(ok)
-- address names STRESS0..STRESS40 as they appear: a name not there yet is
-- FAILURE RC 30, a name there gives the command plus one
::method stress
  use arg threads, done
  reply
  ok = 1
  do i = 1 to 400
    if \self~one("STRESS" || random(0, 40), i) then ok = 0
  end
  done~queue(ok)
-- (the trap in a method of its own: a label inside a DO is Error 47.2)
::method one
  use arg name, i
  trace off                                 -- (no trace of each FAILURE)
  signal on failure
  address value name
  '' i
  return rc = i + 1
failure:
  return rc = 30

::class RexxHandler inherit CommandHandler
::method command
  use arg command, caller
  return 1000 + command~length

::class Raiser
::method halt;     raise halt
::method user;     raise user x description "d"
::method notready; raise notready
::method error;    raise error 5
::method failure;  raise failure 6

::class Boom2
::method boom
  raise user x description "d" additional ("a") return 7

::class Boom
::method boom
  return "a" + 1

::class Boom3
::method boom
  raise syntax 40.1 array("BOOM") description "the description"

-- a destination for .output / .error: each line, with a prefix, into lines
::class Collect
::method init
  expose lines prefix
  use arg lines, prefix
::method lineout
  expose lines prefix
  use arg line
  lines~append(prefix line)
  return 0
::method say
  forward message("LINEOUT")
::method charout
  return 0
