#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Address.testGroup: ADDRESS LUA (docs/design.md, *ADDRESS LUA*): commands   */
/* run in .lua; RC 0 and the results in RESULT; ERROR / FAILURE with Lua's    */
/* message as condition('A').                                                 */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Address.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "Address.testGroup" subclass LuaTestCase public

::method test_runs_in_dot_lua
  address lua 'addressTest = 41'
  self~assertEquals(0, rc)
  self~assertEquals(41, .lua~global("addressTest"))
  address lua
  'addressTest = addressTest + 1'
  self~assertEquals(42, .lua~global("addressTest"))
  'addressTest = nil'

::method test_result_none_is_dropped
  result = "old"
  address lua 'local x = 1'
  self~assertEquals(0, rc)
  self~assertFalse(var("RESULT"), "no results: RESULT dropped, as CALL does")
  result = "old"
  address lua 'return'
  self~assertFalse(var("RESULT"))
  result = "old"
  address lua ''
  self~assertEquals(0, rc, "the empty command")
  self~assertFalse(var("RESULT"))

::method test_result_one
  -- (a message instruction such as self~assert... sets or drops RESULT itself)
  address lua '6 * 7'; r = result           -- an expression, as ~eval
  self~assertEquals(42, r)
  address lua 'return "abc"'; r = result
  self~assertSame("abc", r)
  address lua 'return nil'; set = var("RESULT"); r = result
  self~assertTrue(set, "return nil is one result")
  self~assertSame(.nil, r)
  address lua 'return {10, 20}'; r = result
  self~assertSame("LUAOBJECT", r~class~id)
  self~assertEquals(20, r[2])
  address lua 'return "3.10", 0.5'; r = result
  self~assertSame("3.10", r[1])
  self~assertEquals(0.5, r[2])

::method test_result_several_is_an_array
  address lua 'return 1, nil, "m"'; r = result
  self~assertEquals(0, rc)
  self~assertTrue(r~isA(.Array))
  self~assertEquals(3, r~items, "one item per result, nil included")
  self~assertEquals(1, r[1])
  self~assertSame(.nil, r[2])
  self~assertSame("m", r[3])
  address lua 'return nil, "not found"'; r = result     -- a failure by Lua's convention is a value
  self~assertEquals(0, rc)
  self~assertSame("not found", r[2])

::method test_runtime_error_is_ERROR
  trace off
  do
    address lua 'error("boom")'
  catch c = error, failure
  end
  self~assertEquals(1, rc)
  self~assertSame("ERROR", c~condition)
  self~assertEquals('error("boom")', c~description)
  self~assertSame("ADDRESS LUA:1: boom", c~additional~makeArray("0a"x)[1])
  self~assertTrue(c~additional~pos("stack traceback:") > 0, "with Lua's traceback")

::method test_compile_error_is_FAILURE
  trace off
  do
    address lua 'this is not Lua'
  catch c = error, failure
  end
  self~assertEquals(-1, rc)
  self~assertSame("FAILURE", c~condition)
  self~assertTrue(c~additional~pos("syntax error") > 0, c~additional)

::method test_signal_on_error
  signal on error
  address lua 'error("x")'
  self~fail("ERROR not raised")
error:
  self~assertEquals(1, rc)
  self~assertTrue(condition("A")~pos("ADDRESS LUA:1: x") = 1)

::method test_untrapped_error_goes_on
  trace off
  address lua 'error("x")'                  -- like any command: RC, and the program goes on
  self~assertEquals(1, rc)

::method test_callbacks_into_Rexx
  .lua~global("_G")["addressTwice"] = .routines~twice     -- (~name= would make it lowercase)
  address lua 'return addressTwice(21)'; r = result
  self~assertEquals(0, rc)
  self~assertEquals(42, r)
  do
    address lua 'addressTwice("x")'         -- a Rexx error inside: a Lua error, so ERROR
  catch c = error
  end
  .lua~global("_G")["addressTwice"] = .nil
  self~assertEquals(1, rc)
  self~assertTrue(c~additional~pos("Rexx error 41.1") = 1, c~additional)

::method test_no_usable_lua_is_FAILURE
  trace off
  saved = .lua
  do
    .local~lua = "not a state"
    do
      address lua '1'
    catch c = failure
    end
    self~assertEquals(-2, rc)
    s = .LuaState~new
    s~close
    .local~lua = s
    do
      address lua '1'
    catch c = failure
    end
  finally                                       -- the next tests need .lua
    .local~lua = saved
  end
  self~assertEquals(-2, rc)
  self~assertSame("the LuaState is closed", c~additional)

::method test_follows_dot_lua
  saved = .lua
  s = .LuaState~new
  do
    .local~lua = s
    address lua 'where = "mine"'
  finally
    .local~lua = saved
  end
  self~assertSame("mine", s~global("where"))
  self~assertSame(.nil, saved~global("where"))
  s~close

::method test_halt_in_a_callback_is_Error_4_1
  .lua~global("_G")["addressHalt"] = .routines~halts
  do
    address lua 'addressHalt()'
    c = .nil
  catch c = syntax
  end
  .lua~global("_G")["addressHalt"] = .nil
  self~assertFalse(c~isNil, "a HALT in a callback was lost")
  self~assertSame("4.1", c~code, "as ~eval: the program stops unless SYNTAX is trapped")

::method test_message_with_a_NUL
  do
    address lua 'error("x\0y")'
  catch c = error
  end
  self~assertTrue(c~additional~pos("x" || "00"x || "y") > 0, "the whole message")

-- a thrown condition (THROW in Rexx code the command calls, or oorexx.throw)
-- is not an error of the command: it reaches the issuer as itself, as a
-- HALT does (the user, 20/11/2026), and goes on from caller to caller (since
-- ooRexx r13557: before it, a condition thrown by a native command
-- environment stopped at the issuer); a raised one, and a Lua error, are ERROR
::method test_a_throw_in_the_command_from_rexx
  .lua~global("_G")["addressThrower"] = .routine~new("t", 'throw user badConfig description "from Rexx"')
  do
    address lua 'addressThrower()'
    self~fail("no USER BADCONFIG")
  catch c = user badConfig
  end
  .lua~global("_G")["addressThrower"] = .nil
  self~assertSame("from Rexx", c~description)
  self~assertTrue(c~thrown)

::method test_a_throw_in_the_command_from_lua
  do
    address lua 'require("oorexx").throw("user badConfig", nil, "from Lua")'
    self~fail("no USER BADCONFIG")
  catch c = user badConfig
  end
  self~assertSame("from Lua", c~description)
  self~assertTrue(c~thrown)

::method test_a_throw_syntax_in_the_command
  do
    address lua 'require("oorexx").throw("syntax", "40.1", nil, {"BOOM"})'
    self~fail("no SYNTAX")
  catch c = syntax
  end
  self~assertSame("40.1", c~code)
  self~assertTrue(c~thrown)

::method test_a_throw_in_the_command_past_a_routine
  .lua~global("_G")["addressThrower"] = .routine~new("t", 'throw user badConfig description "from Rexx"')
  .local~lua.test.handled = .false
  do
    call addressIssuer 'addressThrower()'
    self~fail("no USER BADCONFIG")
  catch c = user badConfig
  end
  .lua~global("_G")["addressThrower"] = .nil
  self~assertSame("from Rexx", c~description)
  self~assertTrue(c~thrown)
  self~assertFalse(.local~lua.test.handled, "the issuer's CALL ON does not trap it, nor does it go on")

::method test_a_throw_in_the_command_uncaught_is_error_4_901
  prog = SysTempFileName("athrow????.rex")
  call lineout prog, 'address lua ''require("oorexx").throw("user badConfig", nil, "missing key")'''
  call lineout prog, 'say "went on"'
  call lineout prog, '::requires "lua.cls"'
  call lineout prog
  out = .array~new
  address system 'rexx' prog '2>&1' with output using (out)
  code = rc
  call SysFileDelete prog
  self~assertTrue(code \= 0, "an error")
  self~assertSame("Error 4.901:  Program interrupted with USER BADCONFIG condition: missing key.", out~lastItem~strip("T", "0d"x))

::method test_a_throw_caught_in_the_command_is_nothing
  .lua~global("_G")["addressThrower"] = .routine~new("t", 'throw user badConfig')
  address lua 'return (pcall(addressThrower))'
  r = result; code = rc
  .lua~global("_G")["addressThrower"] = .nil
  self~assertEquals(0, code)
  self~assertSame(0, r, "pcall's false")

::method test_a_raised_condition_in_the_command_is_ERROR
  .lua~global("_G")["addressRaiser"] = .routine~new("t", 'x = 1 + "a"')
  do
    address lua 'addressRaiser()'
  catch c = error
  end
  .lua~global("_G")["addressRaiser"] = .nil
  self~assertEquals(1, rc)
  self~assertTrue(c~additional~pos("Rexx error 41.1") = 1, c~additional)

::method test_a_LuaObject_as_dot_lua
  trace off
  saved = .lua
  do
    .local~lua = saved~global("_G")
    address lua '1'
  catch failure
  finally
    .local~lua = saved
  end
  self~assertEquals(-2, rc)

::method test_registered_once
  .LuaState~"LUA.ADDRESS"                   -- again: nothing happens
  address lua 'return 6 * 7'; r = result
  self~assertEquals(42, r)

::attribute caught
::attribute description
::attribute additional

::routine twice public
  return 2 * arg(1)

::routine halts public
  raise halt

::routine addressIssuer       -- a ::routine between the CATCH and the command
  use arg command
  call on user badConfig name handled
  address lua command
  .local~lua.test.handled = .true      -- not reached
  return
handled:
  .local~lua.test.handled = .true
  return
