#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Address.testGroup: ADDRESS LUA (docs/design.md, *ADDRESS LUA*): commands   */
/* run in .lua; RC 0 and the results in RESULT; ERROR / FAILURE with Lua's    */
/* message as condition('A').                                                 */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Address.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "Address.testGroup" subclass LuaTestCase public

::method test_runs_in_dot_lua
  address lua 'addressTest = 41'
  self~assertEquals(0, rc)
  self~assertEquals(41, .lua~global("addressTest"))
  address lua
  'addressTest = addressTest + 1'
  self~assertEquals(42, .lua~global("addressTest"))
  'addressTest = nil'

::method test_result_none_is_dropped
  result = "old"
  address lua 'local x = 1'
  self~assertEquals(0, rc)
  self~assertFalse(var("RESULT"), "no results: RESULT dropped, as CALL does")
  result = "old"
  address lua 'return'
  self~assertFalse(var("RESULT"))
  result = "old"
  address lua ''
  self~assertEquals(0, rc, "the empty command")
  self~assertFalse(var("RESULT"))

::method test_result_one
  -- (a message instruction such as self~assert... sets or drops RESULT itself)
  address lua '6 * 7'; r = result           -- an expression, as ~eval
  self~assertEquals(42, r)
  address lua 'return "abc"'; r = result
  self~assertEquals("abc", r)
  address lua 'return nil'; set = var("RESULT"); r = result
  self~assertTrue(set, "return nil is one result")
  self~assertSame(.nil, r)
  address lua 'return {10, 20}'; r = result
  self~assertEquals("LUAOBJECT", r~class~id)
  self~assertEquals(20, r[2])
  address lua 'return "3.10", 0.5'; r = result
  self~assertEquals("3.10", r[1])
  self~assertEquals(0.5, r[2])

::method test_result_several_is_an_array
  address lua 'return 1, nil, "m"'; r = result
  self~assertEquals(0, rc)
  self~assertTrue(r~isA(.Array))
  self~assertEquals(3, r~items, "one item per result, nil included")
  self~assertEquals(1, r[1])
  self~assertSame(.nil, r[2])
  self~assertEquals("m", r[3])
  address lua 'return nil, "not found"'; r = result     -- a failure by Lua's convention is a value
  self~assertEquals(0, rc)
  self~assertEquals("not found", r[2])

::method test_runtime_error_is_ERROR
  trace off
  call on error name trapped
  call on failure name trapped
  address lua 'error("boom")'
  self~assertEquals(1, rc)
  self~assertEquals("ERROR", self~caught)
  self~assertEquals('error("boom")', self~description)
  self~assertEquals("ADDRESS LUA:1: boom", self~additional~makeArray("0a"x)[1])
  self~assertTrue(self~additional~pos("stack traceback:") > 0, "with Lua's traceback")
  return
trapped:
  self~caught = condition("C"); self~description = condition("D"); self~additional = condition("A")
  return

::method test_compile_error_is_FAILURE
  trace off
  call on error name trapped
  call on failure name trapped
  address lua 'this is not Lua'
  self~assertEquals(-1, rc)
  self~assertEquals("FAILURE", self~caught)
  self~assertTrue(self~additional~pos("syntax error") > 0, self~additional)
  return
trapped:
  self~caught = condition("C"); self~additional = condition("A")
  return

::method test_signal_on_error
  signal on error
  address lua 'error("x")'
  self~fail("ERROR not raised")
error:
  self~assertEquals(1, rc)
  self~assertTrue(condition("A")~pos("ADDRESS LUA:1: x") = 1)

::method test_untrapped_error_goes_on
  trace off
  address lua 'error("x")'                  -- like any command: RC, and the program goes on
  self~assertEquals(1, rc)

::method test_callbacks_into_Rexx
  .lua~global("_G")["addressTwice"] = .routines~twice     -- (~name= would make it lowercase)
  address lua 'return addressTwice(21)'; r = result
  self~assertEquals(0, rc)
  self~assertEquals(42, r)
  trace off
  call on error name trapped
  address lua 'addressTwice("x")'           -- a Rexx error inside: a Lua error, so ERROR
  self~assertEquals(1, rc)
  self~assertTrue(self~additional~pos("Rexx error 41.1") = 1, self~additional)
  .lua~global("_G")["addressTwice"] = .nil
  return
trapped:
  self~additional = condition("A")
  return

::method test_no_usable_lua_is_FAILURE
  trace off
  saved = .lua
  call on failure name trapped
  .local~lua = "not a state"
  address lua '1'
  self~assertEquals(-2, rc)
  s = .LuaState~new
  s~close
  .local~lua = s
  address lua '1'
  self~assertEquals(-2, rc)
  self~assertEquals("the LuaState is closed", self~additional)
  .local~lua = saved
  return
trapped:
  self~additional = condition("A")
  return

::method test_follows_dot_lua
  saved = .lua
  s = .LuaState~new
  .local~lua = s
  address lua 'where = "mine"'
  .local~lua = saved
  self~assertEquals("mine", s~global("where"))
  self~assertSame(.nil, saved~global("where"))
  s~close

::attribute caught
::attribute description
::attribute additional

::routine twice public
  return 2 * arg(1)
