#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Errors.testGroup: errors both ways (docs/design.md, *Errors*).  A Lua      */
/* error is SYNTAX 98.900 with additional [1] the message, [2] the error      */
/* value, [3] Lua's traceback; a Rexx error is a table with its fields in     */
/* Lua; and each comes back as itself after a round trip.                     */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Errors.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "Errors.testGroup" subclass LuaTestCase public

-- The condition object of the SYNTAX condition that sending the message raises
::method conditionOf
  use strict arg receiver, name, ...
  args = arg(3, "A")
  do
    .message~new(receiver, name, "A", args)~send
  catch c = syntax
    return c
  end
  self~fail("no SYNTAX condition raised by message" name)

-- A Lua error in Rexx ----------------------------------------------------------

::method test_a_Lua_error_is_98_900_with_value_and_traceback
  c = self~conditionOf(.lua, "EVAL", "error('boom')")
  self~assertEquals(98.900, c~code)
  a = c~additional
  self~assertEquals(3, a~items)
  self~assertSame("Lua error: eval:1: boom", a[1])
  self~assertSame("eval:1: boom", a[2], "the error value")
  self~assertTrue(a[3]~pos("stack traceback:") = 1, "Lua's traceback:" a[3])
  self~assertEquals(0, c~message~pos("stack traceback"), "not in the message")
  self~assertSame("Lua error: eval:1: boom.", c~message)

::method test_a_table_error_value_is_a_LuaObject
  a = self~conditionOf(.lua, "EVAL", "error({code = 42})")~additional
  self~assertTrue(a[2]~isA(.LuaObject))
  self~assertEquals(42, a[2]~code)
  self~assertTrue(a[1]~pos("Lua error: table: ") = 1, a[1])

::method test_number_and_boolean_error_values_are_LuaObjects
  a = self~conditionOf(.lua, "EVAL", "error(42)")~additional
  self~assertTrue(a[2]~isA(.LuaObject), "a number")
  self~assertSame("number", .lua~global("type")~call(a[2]))
  self~assertSame("Lua error: 42", a[1])
  a = self~conditionOf(.lua, "EVAL", "error(false)")~additional
  self~assertTrue(a[2]~isA(.LuaObject), "a boolean")
  self~assertSame("boolean", .lua~global("type")~call(a[2]))

::method test_a_Rexx_object_as_error_value_is_that_object
  d = .directory~new
  a = self~conditionOf(.lua, "EVAL", "error(...)", d)~additional
  self~assertSame(d, a[2])

::method test_a_nil_error_value_is_left_out
  a = self~conditionOf(.lua, "EVAL", "error()")~additional
  self~assertSame("Lua error: nil", a[1])
  self~assertNull(a[2])
  self~assertTrue(a[3]~pos("stack traceback:") = 1)

::method test_a_failing_tostring_of_the_error_value
  -- __tostring runs in the message handler: its own error is reported, no crash
  c = self~conditionOf(.lua, "EVAL", "error(setmetatable({}, {__tostring = function() error('bad') end}))")
  self~assertEquals(98.900, c~code)

-- A Rexx error in Lua ----------------------------------------------------------

::method test_a_Rexx_error_is_a_table_with_fields
  bad = .routine~new("bad", .array~of("x = 1", "return x + 'a'"))
  f = .lua~eval("local f = ...; local ok, e = pcall(f); return e", bad)
  self~assertTrue(f~isA(.LuaObject))
  self~assertSame("table", .lua~global("type")~call(f))
  self~assertSame("SYNTAX", f~get("condition"))
  self~assertSame("41.1", f~get("code"))
  self~assertEquals(41, f~get("rc"))
  self~assertSame("Bad arithmetic conversion.", f~get("errortext"))
  self~assertEquals('Nonnumeric value ("a") used in arithmetic operation.', f~get("message"))
  self~assertSame("bad", f~get("program"))
  self~assertEquals(2, f~get("line"))
  self~assertTrue(f~get("traceback")~pos("*-* return x + 'a'") > 0, f~get("traceback"))
  self~assertEquals('Rexx error 41.1: Nonnumeric value ("a") used in arithmetic operation.', f~string)
  self~assertSame("RexxError", .lua~eval("return getmetatable(...)", f), "getmetatable")
  self~assertEquals(0, .lua~eval("return (pcall(setmetatable, ..., {}))", f), "the metatable is protected")

::method test_a_hand_made_98_900_with_nil_is_a_Rexx_error
  -- raiseLuaError never puts .nil in additional[2]: one raised by hand is a Rexx error
  bad = .routine~new("bad", "raise syntax 98.900 array('Lua error: x', .nil)")
  self~assertSame("table 98.900", .lua~eval("local ok, e = pcall(...); return type(e) .. ' ' .. e.code", bad))

::method test_concatenation_and_tostring
  bad = .routine~new("bad", "return 1 + 'a'")
  r = .lua~eval("local f = ...; local ok, e = pcall(f);" -
                "return 'x: ' .. e, e .. '!', tostring(e), type(e)", bad)
  self~assertEquals('x: Rexx error 41.1: Nonnumeric value ("a") used in arithmetic operation.', r)
  r = .lua~eval("function(f) local ok, e = pcall(f); return e .. '!', tostring(e), type(e) end")~callAll(bad)
  self~assertEquals('Rexx error 41.1: Nonnumeric value ("a") used in arithmetic operation.!', r[1])
  self~assertSame("table", r[3])
  c = self~conditionOf(.lua, "EVAL", "local f = ...; local ok, e = pcall(f); return e .. {}", bad)
  self~assertTrue(c~additional[1]~pos("attempt to concatenate a table value") > 0, c~additional[1])

::method test_a_NUL_in_a_Rexx_message_stays
  bad = .routine~new("bad", "raise syntax 98.900 array ('a' || '00'x || 'b')")
  self~assertEquals(1, .lua~eval("local f = ...; local ok, e = pcall(f);" -
                                 "return tostring(e):find('a\0b', 1, true) ~= nil and e.message:find('a\0b', 1, true) == 1", bad))

-- Round trips ------------------------------------------------------------------

::method test_a_Rexx_error_through_Lua_is_itself
  bad = .routine~new("bad", "return 1 + 'a'")
  c = self~conditionOf(.lua, "EVAL", "local f = ...; return f()", bad)
  self~assertEquals(41.1, c~code)
  self~assertEquals('Nonnumeric value ("a") used in arithmetic operation.', c~message)

::method test_raised_again_by_Lua_it_is_itself
  bad = .routine~new("bad", "raise syntax 93.907 array (0)")
  c = self~conditionOf(.lua, "EVAL", "local f = ...; local ok, e = pcall(f); error(e)", bad)
  self~assertEquals(93.907, c~code)
  self~assertEquals(.array~of(0), c~additional, "with its substitutions")
  -- made a string, it is a Lua error
  c = self~conditionOf(.lua, "EVAL", "local f = ...; local ok, e = pcall(f); error(tostring(e), 0)", bad)
  self~assertEquals(98.900, c~code)
  self~assertTrue(c~additional[2]~pos("Rexx error 93.907") = 1, c~additional[2])

-- its DESCRIPTION too (raised again as it is, RaiseConditionObject)
::method test_a_syntax_keeps_its_description
  bad = .routine~new("bad", "raise syntax 40.1 array('BOOM') description 'the description'")
  c = self~conditionOf(.lua, "EVAL", "local f = ...; return f()", bad)
  self~assertEquals(40.1, c~code)
  self~assertSame("BOOM", c~additional[1])
  self~assertSame("the description", c~description, "through Lua")
  c = self~conditionOf(.lua, "EVAL", "local f = ...; local ok, e = pcall(f); error(e)", bad)
  self~assertSame("the description", c~description, "raised again by Lua")

-- raised again as it is (RaiseConditionObject): its traceback starts where
-- the error was, in the Rexx code Lua called, as in plain Rexx
::method test_a_syntax_keeps_its_traceback
  bad = .routine~new("bad", .array~of("nop", "x = 1 + 'a'"))
  c = self~conditionOf(.lua, "EVAL", "local f = ...; return f()", bad)
  self~assertEquals(41.1, c~code)
  self~assertTrue(c~traceback~firstItem~strip~startsWith("2 *-* x = 1 + 'a'"), c~traceback~firstItem)

-- a native routine that uses its caller's variables, called from Lua, has no
-- Rexx caller: a SYNTAX error since ooRexx r13326 (#2129; before, a crash)
::method test_a_native_routine_wanting_its_callers_variables
  s.0 = 2; s.1 = 'b'; s.2 = 'a'
  c = self~conditionOf(.lua, "EVAL", "local f = ...; return f('s.')", .context~package~findRoutine("STEMSORT"))
  self~assertEquals(40.919, c~code)
  self~assertSame("b", s.1, "the stem untouched")

::method test_a_Lua_error_through_Rexx_is_itself
  -- Lua -> Rexx -> Lua: the error value Lua raised, not a Rexx error around it
  inner = .routine~new("inner", "return .lua~eval('error({code = 42})')")
  self~assertEquals(42, .lua~eval("local f = ...; local ok, e = pcall(f); return e.code", inner))
  inner = .routine~new("inner", "return .lua~eval('error(""boom"", 0)')")
  self~assertSame("string boom", .lua~eval("local f = ...; local ok, e = pcall(f); return type(e) .. ' ' .. e", inner))
  -- a string error value stays a string ("42" is not made a number)
  inner = .routine~new("inner", "return .lua~eval('error(""42"", 0)')")
  self~assertSame("string", .lua~eval("local f = ...; local ok, e = pcall(f); return type(e)", inner))
  -- and Rexx -> Lua -> Rexx -> Lua error, back in Rexx: 98.900 with the value
  c = self~conditionOf(.lua, "EVAL", "local f = ...; return f()", inner)
  self~assertEquals(98.900, c~code)
  self~assertSame("Lua error: 42", c~additional[1])

::method test_a_value_of_another_state_is_a_Rexx_error
  s = .LuaState~new
  inner = .routine~new("inner", "use arg s; return s~eval('error({})')")
  r = .lua~eval("function(f, s) local ok, e = pcall(f, s); return type(e), e.code end")~callAll(inner, s)
  self~assertSame("table", r[1])
  self~assertSame("98.900", r[2], "a Rexx error around it")
  s~close

-- The bridge's own errors keep one additional item
::method test_the_bridges_own_errors
  s = .LuaState~new; s~close
  c = self~conditionOf(s, "EVAL", "1")
  self~assertEquals(98.900, c~code)
  self~assertEquals(1, c~additional~items)

-- A SIGNAL past Lua (docs/design.md, *Errors*): Rexx calls Lua directly, Lua
-- calls a Rexx method that does RAISE USER X ... RETURN, and the caller has
-- SIGNAL ON USER X.  ooRexx unwinds to the caller by a C++ throw, which the
-- bridge stops before Lua's frames and throws again once Lua has unwound.
-- Without that, each unwind left Lua's call count up: by ~200 of them, "C
-- stack overflow" (oorexx-bridges inbox/lua.md, 19/10/2026).
::method test_signal_past_lua_many_times
  o = .Raiser~new
  f = .lua~eval("return function(o) return o:boom() end")
  do i = 1 to 500
    if \signalPast(f, o) then do
      self~fail("not trapped, at" i)
      leave
    end
  end
  self~assertEquals(50, .lua~eval("local function d(n) if n == 0 then return 0 end return 1 + d(n - 1) end return d(50)"), -
    "Lua is still sound")
  self~assertEquals(42, .lua~eval("return 6 * 7"))

::method test_signal_past_lua_with_its_condition
  f = .lua~eval("return function(o) return o:boom() end")
  signal on user x
  f~call(.Raiser~new)
  self~fail("no USER X")
x:
  c = condition("O")
  self~assertSame("USER X", c~condition)
  self~assertSame("d", c~description)
  self~assertSame("a", c~additional)

-- a pcall in Lua does not stop it: Lua goes on after its pcall, with an error
-- that says so, and the SIGNAL happens when Lua returns to the bridge
-- (and its garbage collection there runs the finalizers of Rexx objects,
-- which must not call Rexx while it unwinds: that crashed on macOS)
::method test_signal_past_lua_through_a_pcall
  f = .lua~eval("return function(o, mk) local junk = {} for i = 1, 200 do junk[i] = mk() end junk = nil" -
                "  local ok, e = pcall(function() return o:boom() end)" -
                "  collectgarbage(); collectgarbage()" -
                "  unwindSeen = tostring(ok) .. ' ' .. tostring(e) return 'after' end")
  signal on user x
  r = f~call(.Raiser~new, .routine~new("mk", "return .object~new"))
  self~fail("no USER X; the function returned" r)
x:
  self~assertSame("false a Rexx condition is unwinding through Lua", .lua~global("unwindSeen"))
  .lua~eval("unwindSeen = nil")

::method test_signal_past_lua_from_a_string_method
  f = .lua~eval("return function(o) return tostring(o) end")
  signal on user x
  f~call(.StringRaiser~new)
  self~fail("no USER X")
x:
  self~assertSame("from string", condition("O")~description)

-- the same with the value a callback returns (oorexx-bridges, lesson 6):
-- the bridge does not convert it (a userdata, no message sent); its STRING
-- runs only when Lua asks, under the same guard, many times
::method test_signal_past_lua_from_a_callbacks_reply
  f = .lua~eval("return function(o) return tostring(o:reply()) end")
  do 200
    self~assertSame("from string", self~replyTrap(f))
  end
  self~assertEquals(42, .lua~eval("return 6 * 7"), "Lua still works")

::method replyTrap
  use arg f
  signal on user x
  f~call(.ReplyMaker~new)
  return "no USER X"
x:
  return condition("O")~description

::method test_signal_past_address_lua
  .lua~eval("unwindRaiser = ...", .Raiser~new)
  signal on user x
  address lua 'return unwindRaiser:boom()'
  self~fail("no USER X")
x:
  self~assertSame("d", condition("O")~description)
  address lua 'unwindRaiser = nil; return 1 + 1'
  self~assertEquals(2, result, "ADDRESS LUA still works")

-- the same with CATCH (ooRexx RFE #31, r13514): it unwinds as SIGNAL does
::method test_catch_past_lua_many_times
  o = .Raiser~new
  f = .lua~eval("return function(o) return o:boom() end")
  do i = 1 to 500
    if \catchPast(f, o) then do
      self~fail("not caught, at" i)
      leave
    end
  end
  self~assertEquals(50, .lua~eval("local function d(n) if n == 0 then return 0 end return 1 + d(n - 1) end return d(50)"), -
    "Lua is still sound")

::method test_catch_past_lua_through_a_pcall
  f = .lua~eval("return function(o, mk) local junk = {} for i = 1, 200 do junk[i] = mk() end junk = nil" -
                "  local ok, e = pcall(function() return o:boom() end)" -
                "  collectgarbage(); collectgarbage()" -
                "  unwindSeen = tostring(ok) .. ' ' .. tostring(e) return 'after' end")
  do
    r = f~call(.Raiser~new, .routine~new("mk", "return .object~new"))
    self~fail("no USER X; the function returned" r)
  catch c = user x
  end
  self~assertSame("d", c~description)
  self~assertSame("false a Rexx condition is unwinding through Lua", .lua~global("unwindSeen"))
  .lua~eval("unwindSeen = nil")

-- CALL ON: the trap runs, then the code goes on: nothing unwinds
::method test_call_on_past_lua
  f = .lua~eval("return function(o) return o:boom() end")
  call on user x name trapped
  self~trapped = .false
  r = f~call(.Raiser~new)
  self~assertSame(7, r, "the method's value")
  self~assertTrue(self~trapped)
  return
trapped:
  self~trapped = .true
  return
-- A THROW (ooRexx RFE #31, r13541) in Rexx code that Lua calls: the API
-- call returns with it pending, so nothing unwinds through Lua (unlike a
-- SIGNAL past Lua, above); Lua sees it as its table, and back in Rexx it is
-- thrown again as itself, from caller to caller, as in plain Rexx
::method thrower
  return .routine~new("t", 'throw user x description "d" additional ("a")')

::method test_throw_past_lua_two_levels_out
  f = .lua~eval("return function(r) r() end")
  do
    call throwThrough f, self~thrower
    self~fail("no USER X")
  catch c = user x
  end
  self~assertSame("USER X", c~condition)
  self~assertSame("d", c~description)
  self~assertSame("a", c~additional)
  self~assertTrue(c~thrown, "still thrown")
  self~assertTrue(c~propagated)

::method test_throw_past_lua_not_trapped_by_call_on
  f = .lua~eval("return function(r) r() end")
  .local~lua.test.handled = .false
  do
    call throwPastCallOn f, self~thrower
    self~fail("no USER X")
  catch c = user x
  end
  self~assertFalse(.local~lua.test.handled, "CALL ON does not trap a thrown condition")
  self~assertTrue(c~thrown)

::method test_throw_past_lua_signal_on
  f = .lua~eval("return function(r) r() end")
  self~assertSame("1 d", throwSignalOn(f, self~thrower))

::method test_throw_past_lua_from_a_method
  f = .lua~eval("return function(o) return o:throw() end")
  do
    f~call(.Thrower~new)
    self~fail("no USER X")
  catch c = user x
  end
  self~assertSame("from a method", c~description)
  self~assertTrue(c~thrown)

::method test_throw_syntax_past_lua
  f = .lua~eval("return function(r) r() end")
  do
    f~call(.routine~new("s", 'throw syntax 40.1 array("BOOM")'))
    self~fail("no SYNTAX")
  catch c = syntax
  end
  self~assertSame("40.1", c~code)
  self~assertTrue(c~thrown, "THROW SYNTAX is thrown, not raised")

-- Lua sees the condition, not "unwinding": a pcall stops it, and the Lua
-- code goes on; nothing comes back to Rexx
::method test_throw_caught_by_a_pcall_in_lua
  f = .lua~eval("return function(r) local ok, e = pcall(r)" -
                "  return tostring(ok) .. ' ' .. getmetatable(e) .. ' ' .. e.condition .. ' ' .. tostring(e.thrown)" -
                "    .. ' ' .. e.description .. ' | ' .. tostring(e) end")
  self~assertSame("false RexxError USER X true d | Rexx condition USER X: d", f~call(self~thrower))
  self~assertEquals(42, .lua~eval("return 6 * 7"), "nothing pending")

::method test_throw_raised_again_by_lua_is_thrown_again
  f = .lua~eval("return function(r) local ok, e = pcall(r); error(e) end")
  do
    call throwThrough f, self~thrower
    self~fail("no USER X")
  catch c = user x
  end
  self~assertSame("d", c~description)
  self~assertTrue(c~thrown, "error(e) keeps it thrown")

::method test_throw_past_lua_uncaught_is_error_4_901
  prog = SysTempFileName("throw????.rex")
  call lineout prog, 'call r; say "not reached"; exit'
  call lineout prog, 'r: .lua~eval("local r = ...; r()", .routine~new("t", ''throw user badConfig description "missing key"''))'
  call lineout prog, '::requires "lua.cls"'
  call lineout prog
  out = .array~new
  address system 'rexx' prog '2>&1' with output using (out)
  code = rc
  call SysFileDelete prog
  self~assertTrue(code \= 0, "an error")
  self~assertSame("Error 4.901:  Program interrupted with USER BADCONFIG condition: missing key.", out~lastItem~strip("T", "0d"x))

-- oorexx.throw (oorexx-bridges topics/host-throw.md, decided 20/11/2026):
-- Lua code throws a Rexx condition, throw(condition, rc, description,
-- additional), as THROW and the Throw() API do
::method luaThrower
  return .lua~eval("local rexx = require 'oorexx'; return function(...) rexx.throw(...) end")

::method test_lua_throw_user_two_levels_out
  do
    call throwThrough self~luaThrower, "user badConfig", .nil, "missing key", .lua~eval("return {port = 80}")
    self~fail("no USER BADCONFIG")
  catch c = user badConfig
  end
  self~assertSame("USER BADCONFIG", c~condition)
  self~assertSame("missing key", c~description)
  self~assertTrue(c~thrown)
  self~assertSame(80, c~additional["port"], "additional, as an argument would be")

::method test_lua_throw_not_trapped_by_call_on
  .local~lua.test.handled = .false
  do
    call throwPastCallOn self~luaThrower, "user x"
    self~fail("no USER X")
  catch c = user x
  end
  self~assertFalse(.local~lua.test.handled)
  self~assertSame("", c~description, "none: a null string, as THROW gives")

::method test_lua_throw_error_with_its_rc
  do
    call throwThrough self~luaThrower, "error", 12, "the command"
  catch c = error
  end
  self~assertEquals(12, c~rc)
  self~assertSame("the command", c~description)
  self~assertTrue(c~thrown)

::method test_lua_throw_syntax
  do
    call throwThrough self~luaThrower, "syntax", "40.1", .nil, .lua~eval("return {'BOOM'}")
  catch c = syntax
  end
  self~assertSame("40.1", c~code)
  self~assertSame('External routine "BOOM" failed.', c~message)
  self~assertTrue(c~thrown)

::method test_lua_throw_caught_by_a_pcall
  f = .lua~eval("local rexx = require 'oorexx'; return function()" -
                "  local ok, e = pcall(rexx.throw, 'user x', nil, 'd')" -
                "  return tostring(ok) .. ' ' .. getmetatable(e) .. ' ' .. e.condition .. ' ' .. tostring(e.thrown) .. ' | ' .. tostring(e) end")
  self~assertSame("false RexxError USER X true | Rexx condition USER X: d", f~call)
  self~assertEquals(42, .lua~eval("return 6 * 7"), "nothing pending")

::method test_lua_throw_raised_again_with_error
  f = .lua~eval("local rexx = require 'oorexx'; return function() local ok, e = pcall(rexx.throw, 'user x', nil, 'd'); error(e) end")
  do
    call throwThrough f
  catch c = user x
  end
  self~assertSame("d", c~description)
  self~assertTrue(c~thrown)

-- arguments THROW would not accept: a Lua error at the call, 98.900 in Rexx
::method test_lua_throw_bad_arguments
  t = self~luaThrower
  self~assertTrue(self~luaThrowError(t, "oops")~pos("not a condition THROW accepts: 'oops'") > 0)
  self~assertTrue(self~luaThrowError(t, "user")~pos("not a condition THROW accepts") > 0)
  self~assertTrue(self~luaThrowError(t, "halt now")~pos("not a condition THROW accepts") > 0)
  self~assertTrue(self~luaThrowError(t, "user x", 5)~pos("the USER X condition has no rc") > 0)
  self~assertTrue(self~luaThrowError(t, "failure")~pos("the FAILURE condition needs an rc") > 0)
  self~assertTrue(self~luaThrowError(t, "syntax", "40.1.2")~pos("not an error code: '40.1.2'") > 0)
  self~assertTrue(self~luaThrowError(t, "syntax", "40.1", .nil, "BOOM")~pos("are a table") > 0)

::method luaThrowError
  use arg f, ...
  do
    .message~new(f, "CALL", "A", arg(2, "A"))~send
    return "no error"
  catch c = syntax
  end
  if c~code \== "98.900" then return "SYNTAX" c~code
  return c~additional[1]

::method test_lua_throw_uncaught_is_error_4_901
  prog = SysTempFileName("lthrow????.rex")
  call lineout prog, '.lua~eval("require(''oorexx'').throw(''user badConfig'', nil, ''missing key'')")'
  call lineout prog, '::requires "lua.cls"'
  call lineout prog
  out = .array~new
  address system 'rexx' prog '2>&1' with output using (out)
  code = rc
  call SysFileDelete prog
  self~assertTrue(code \= 0, "an error")
  self~assertSame("Error 4.901:  Program interrupted with USER BADCONFIG condition: missing key.", out~lastItem~strip("T", "0d"x))

::attribute trapped

::routine throwThrough      -- a level between the CATCH and the call into Lua
  use arg f, ...
  .message~new(f, "CALL", "A", arg(2, "A"))~send
  return

::routine throwPastCallOn
  use arg f, ...
  call on user x name handled
  .message~new(f, "CALL", "A", arg(2, "A"))~send
  return
handled:
  .local~lua.test.handled = .true
  return

::routine throwSignalOn
  use arg f, r
  signal on user x
  f~call(r)
  return "not trapped"
x:
  c = condition("O")
  return c~thrown c~description

::routine signalPast        -- true if f~call(o)'s USER X reached this trap
  use arg f, o
  signal on user x
  f~call(o)
  return .false
x:
  return .true

::routine catchPast         -- true if f~call(o)'s USER X reached this CATCH
  use arg f, o
  do
    f~call(o)
  catch user x
    return .true
  end
  return .false

::class Raiser
::method boom
  raise user x description "d" additional ("a") return 7

::class Thrower
::method throw
  throw user x description "from a method"

::class StringRaiser
::method string
  raise user x description "from string" return "s"

::class ReplyMaker                -- a callback whose reply raises in its STRING
::method reply
  return .StringRaiser~new

::routine stemSort external "LIBRARY rexxutil SysStemSort"
