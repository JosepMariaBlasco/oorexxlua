#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Table.testGroup: s~table(x), a copy of a Directory, a StringTable or an    */
/* Array, and of their subclasses (docs/design.md, *Rexx objects in Lua*;     */
/* oorexx-bridges, topics/directory-crossing.md).                             */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Table.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "Table.testGroup" subclass LuaTestCase public

::method init
  forward class (super) continue
  -- the table, its pairs sorted, nested tables in braces: "k=v k={...}"
  self~setMethod("SHOW", "use arg t; return .lua~eval(" -
    "'local function show(t) local r = {} for k, v in pairs(t) do" -
    " r[#r + 1] = tostring(k) .. ''='' .. (type(v) == ''table'' and ''{'' .. show(v) .. ''}'' or tostring(v)) end" -
    " table.sort(r) return table.concat(r, '' '') end return show(...)', t)", "OBJECT")

-- Keys as stored: d~name stores NAME, d["name"] keeps the case
::method test_keys_as_stored
  d = .directory~new; d~name = "x"; d["low"] = "y"
  self~assertSame("NAME=x low=y", self~show(.lua~table(d)))
  s = .stringtable~new; s["A"] = 1; s["b"] = 2
  self~assertSame("A=1 b=2", self~show(.lua~table(s)))

-- A subclass is copied as its class is
::method test_subclasses_are_copied
  d = .TDir~new; d~name = "x"; d["low"] = "y"
  self~assertSame("NAME=x low=y", self~show(.lua~table(d)))
  s = .TStringTable~new; s["A"] = 1
  self~assertSame("A=1", self~show(.lua~table(s)))
  a = .TArray~of(1, "two", 3)
  self~assertSame("1=1 2=two 3=3", self~show(.lua~table(a)))

-- Read as ooRexx enumerates it, by SUPPLIER (what DO WITH ... OVER sees): an
-- own SUPPLIER is honoured, an own AT only as far as SUPPLIER uses it, and a
-- computed entry (UNKNOWN) is not data (topics/directory-crossing.md)
::method test_subclasses_are_read_by_supplier
  d = .TAtDir~new; d~k = "stored"
  self~assertSame("K=stored", self~show(.lua~table(d)), "own AT")
  do with index k item v over d; self~assertSame("K stored", k v, "as DO WITH sees it"); end
  s = .TSupplierDir~new; s~k = "stored"
  self~assertSame("Z=99", self~show(.lua~table(s)), "own SUPPLIER")
  u = .TUnknownDir~new; u~k = "stored"
  self~assertSame("stored", u~computed, "UNKNOWN answers")
  self~assertSame("K=stored", self~show(.lua~table(u)), "but is not copied")
  a = .TAtArray~of(1, 2)
  self~assertSame("1=1 2=2", self~show(.lua~table(a)), "own AT of an Array")

-- A SUPPLIER that answers no Supplier is SYNTAX 98.994, as DO ... OVER gives
-- in plain Rexx (crashed before: oorexx-bridges, lesson 7 of 29/10/2026);
-- for pairs() from Lua too.  DIMENSIONS that are not an Array: an error
::method test_a_supplier_that_is_not_one
  do v over .array~of(.TNoSupplierDir~new, .TStringSupplierDir~new, .TStringSupplierTable~new, .TStringSupplierArray~new)
    self~assertEquals(98.994, tableError(v), v~class~id)
    self~assertEquals(98.994, doOverError(v), v~class~id "in plain Rexx")
  end
  self~assertEquals(98.994, tableError(.TStringSupplier~new, "local o = ...; for k in pairs(o) do end"), "pairs")
  self~assertEquals(98.900, tableError(.TStringDimensionsArray~of(1)), "DIMENSIONS")
  self~assertSame(2, .lua~eval("return 1 + 1"), "Lua still works")

-- An Array subclass keeps its shape (DIMENSIONS): trailing empty slots, and
-- dimensions, as the class itself (topics/array-shape.md)
::method test_array_subclass_shape
  h = .TArray~new(5); h[1] = 1; h[3] = "x"
  self~assertSame("1=1 3=x n=5", self~show(.lua~table(h)), "trailing empty slots")
  self~assertSame(self~show(.lua~eval("return ...", .array~new(5)~~put(1, 1)~~put("x", 3))), -
    self~show(.lua~table(h)), "the same as the class")
  m = .TArray~new(2, 3); m[1, 1] = "a"
  self~assertSame("1={1=a n=3} 2={n=3}", self~show(.lua~table(m)), "2x3, only m[1,1]")
  f = .TArray~new(2, 3); do i = 1 to 2; do j = 1 to 3; f[i, j] = i * 10 + j; end; end
  self~assertSame("1={1=11 2=12 3=13} 2={1=21 2=22 3=23}", self~show(.lua~table(f)), "2x3 full")
  e = .TArray~new(2, 3)
  self~assertSame("1={n=3} 2={n=3}", self~show(.lua~table(e)), "2x3 empty")

::class TDir subclass directory
::class TStringTable subclass stringtable
::class TArray subclass array
::class TAtDir subclass directory
::method at
  use arg i
  return "AT:" || self~at:super(i)
::class TSupplierDir subclass directory
::method supplier                       -- what it enumerates is its own
  return .supplier~new(.array~of(99), .array~of("Z"))
::class TUnknownDir subclass directory
::method unknown                        -- COMPUTED is computed; the rest as a Directory
  use arg name
  if name == "COMPUTED" then return self["K"]
  forward class (super)
::class TAtArray subclass array
::method at
  use arg i
  return self~at:super(i) * 10

::class TNoSupplierDir subclass directory
::method supplier; return
::class TStringSupplierDir subclass directory
::method supplier; return "str"
::class TStringSupplierTable subclass stringtable
::method supplier; return "str"
::class TStringSupplierArray subclass array
::method supplier; return "str"
::class TStringSupplier
::method supplier; return "str"
::class TStringDimensionsArray subclass array
::method dimensions; return "str"

::routine tableError                     -- the code of ~table(v)'s error, or of eval(code, v)'s
  use arg v, code
  signal on syntax
  if arg(2, "E") then .lua~eval(code, v)
  else .lua~table(v)
  return 0
syntax:
  return condition("O")~code

::routine doOverError
  use arg v
  signal on syntax
  do with index i item x over v; end
  return 0
syntax:
  return condition("O")~code
