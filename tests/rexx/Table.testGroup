#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Table.testGroup: s~table(x), a copy of a Directory, a StringTable or an    */
/* Array, and of their subclasses (docs/design.md, *Rexx objects in Lua*;     */
/* oorexx-bridges, topics/directory-crossing.md).                             */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Table.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "Table.testGroup" subclass LuaTestCase public

::method init
  forward class (super) continue
  -- the table's pairs, sorted, "k=v k=v", and its #
  self~setMethod("SHOW", "use arg t; return .lua~eval(" -
    "'local t = ... local r = {} for k, v in pairs(t) do r[#r + 1] = tostring(k) .. ''='' .. tostring(v) end" -
    " table.sort(r) return table.concat(r, '' '') .. '' #'' .. #t', t)", "OBJECT")

-- Keys as stored: d~name stores NAME, d["name"] keeps the case
::method test_keys_as_stored
  d = .directory~new; d~name = "x"; d["low"] = "y"
  self~assertSame("NAME=x low=y #0", self~show(.lua~table(d)))
  s = .stringtable~new; s["A"] = 1; s["b"] = 2
  self~assertSame("A=1 b=2 #0", self~show(.lua~table(s)))

-- A subclass is copied as its class is
::method test_subclasses_are_copied
  d = .TDir~new; d~name = "x"; d["low"] = "y"
  self~assertSame("NAME=x low=y #0", self~show(.lua~table(d)))
  s = .TStringTable~new; s["A"] = 1
  self~assertSame("A=1 #0", self~show(.lua~table(s)))
  a = .TArray~of(1, "two", 3)
  self~assertSame("1=1 2=two 3=3 #3", self~show(.lua~table(a)))
  h = .TArray~new(4); h[1] = 1; h[3] = "x"
  self~assertSame("1=1 3=x n=4 #1", self~show(.lua~table(h)), "holes, and n")

-- Read by messages: an AT of its own is honoured; a computed entry is not data
::method test_subclasses_are_read_by_messages
  d = .TAtDir~new; d~k = "stored"
  self~assertSame("K=AT:stored #0", self~show(.lua~table(d)))
  u = .TUnknownDir~new; u~k = "stored"
  self~assertSame("stored", u~computed, "UNKNOWN answers")
  self~assertSame("K=stored #0", self~show(.lua~table(u)), "but is not copied")
  a = .TAtArray~of(1, 2)
  self~assertSame("1=10 2=20 #2", self~show(.lua~table(a)))

-- A multi-dimensional Array subclass is an error (the class itself is nested)
::method test_multidimensional_subclass
  m = .TArray~new(2, 2); m[1, 1] = 1
  signal on syntax
  .lua~table(m)
  self~fail("an error")
syntax:
  self~assertSame("98.900", condition("O")~code)

::class TDir subclass directory
::class TStringTable subclass stringtable
::class TArray subclass array
::class TAtDir subclass directory
::method at
  use arg i
  return "AT:" || self~at:super(i)
::class TUnknownDir subclass directory
::method unknown                        -- COMPUTED is computed; the rest as a Directory
  use arg name
  if name == "COMPUTED" then return self["K"]
  forward class (super)
::class TAtArray subclass array
::method at
  use arg i
  return self~at:super(i) * 10
