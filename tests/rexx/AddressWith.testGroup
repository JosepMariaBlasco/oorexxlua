#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* AddressWith.testGroup: ADDRESS LUA ... WITH (docs/design.md, *ADDRESS      */
/* LUA*, *WITH*): print, io.write and io.stdout write to OUTPUT, io.stderr to */
/* ERROR, io.read, io.lines and io.stdin read INPUT, while the command runs;  */
/* io.output, io.input and io.type know the stand-ins, and io.write, io.read  */
/* and io.lines follow Lua's default files.                                   */
/* Needs ooRexx r13275 or later (#2111, #2112).                               */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.AddressWith.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'LuaTestCase.cls'

::class "AddressWith.testGroup" subclass LuaTestCase public

-- the originals, to compare with after each command
::method setUp
  address lua 'withOrig = {print = print, write = io.write, read = io.read, lines = io.lines,' -
              'stdin = io.stdin, stdout = io.stdout, stderr = io.stderr,' -
              'output = io.output, input = io.input, type = io.type, close = io.close}'

::method tearDown
  address lua 'print, io.write, io.read, io.lines = withOrig.print, withOrig.write, withOrig.read, withOrig.lines;' -
              'io.stdin, io.stdout, io.stderr = withOrig.stdin, withOrig.stdout, withOrig.stderr;' -
              'io.output, io.input, io.type, io.close = withOrig.output, withOrig.input, withOrig.type, withOrig.close;' -
              'io.output(io.stdout); io.input(io.stdin); withOrig = nil'

::method restored
  expose rc
  address lua 'return print == withOrig.print and io.write == withOrig.write and io.read == withOrig.read' -
              'and io.lines == withOrig.lines and io.stdin == withOrig.stdin and io.stdout == withOrig.stdout' -
              'and io.stderr == withOrig.stderr and io.output == withOrig.output and io.input == withOrig.input' -
              'and io.type == withOrig.type and io.close == withOrig.close'
  return result

::method test_print_to_output_stem
  address lua 'print("hello", 41 + 1, nil, true, 1.5)' with output stem out.
  self~assertEquals(0, rc)
  self~assertEquals(1, out.0)
  self~assertSame("hello" || '09'x || "42" || '09'x || "nil" || '09'x || "true" || '09'x || "1.5", out.1)
  self~assertTrue(self~restored, "print is Lua's again")

::method test_print_uses_tostring
  address lua 'print(setmetatable({}, {__tostring = function() return "T!" end}))' with output stem out.
  self~assertSame("T!", out.1)

::method test_io_write_lines_are_cut_by_the_redirector
  address lua 'io.write("a", 1, " ", 2.5); io.write("b\n"); io.stdout:write("c"):write("d\ne\n", "f")' -
    with output stem out.
  self~assertEquals(0, rc)
  self~assertEquals(4, out.0)
  self~assertSame("a1 2.5b", out.1, "numbers as io.write writes them, a line in two writes")
  self~assertSame("cd", out.2, "f:write returns f")
  self~assertSame("e", out.3)
  self~assertSame("f", out.4, "the last line, without a line end")

::method test_io_write_returns_stdout
  address lua 'return io.write("") == io.stdout' with output stem out.; r = result
  self~assertTrue(r)
  self~assertEquals(0, out.0)

::method test_io_write_rejects_tables
  trace off
  call on error name trapped
  address lua 'io.write({})' with output stem out.
  self~assertEquals(1, rc)
  self~assertTrue(self~additional~pos("string expected") > 0, self~additional)
  self~assertTrue(self~restored, "restored after an error")
  return
trapped:
  self~additional = condition('A')
  return

::attribute additional

::method test_output_appended
  out.0 = 1; out.1 = "before"
  address lua 'print("after")' with output append stem out.
  self~assertEquals(2, out.0)
  self~assertSame("before", out.1)
  self~assertSame("after", out.2)

::method test_output_to_an_array
  a = .array~of("x")
  address lua 'print("one"); print("two")' with output using (a)
  self~assertEquals(2, a~items, "replaced")
  self~assertSame("one", a[1])
  self~assertSame("two", a[2])

::method test_error_stem
  address lua 'io.stderr:write("warning: ", 7, "\n"); return io.stdout == withOrig.stdout' with error stem err.; r = result
  self~assertEquals(0, rc)
  self~assertTrue(r, "only ERROR redirected: io.stdout is Lua's")
  self~assertEquals(1, err.0)
  self~assertSame("warning: 7", err.1)
  self~assertTrue(self~restored)

::method test_output_and_error_in_one_stem
  address lua 'print("o1"); io.stderr:write("e1\n"); print("o2")' with output stem s. error stem s.
  self~assertEquals(3, s.0)
  self~assertSame("o1", s.1)
  self~assertSame("e1", s.2)
  self~assertSame("o2", s.3)

::method test_only_what_is_redirected
  none.0 = 0
  address lua 'return print ~= withOrig.print, io.read == withOrig.read, io.stdin == withOrig.stdin,' -
              'io.stderr == withOrig.stderr' with output stem out.; r = result
  self~assertEquals(.true, r[1])
  self~assertEquals(.true, r[2])
  self~assertEquals(.true, r[3])
  self~assertEquals(.true, r[4])
  address lua 'return print == withOrig.print, io.read ~= withOrig.read, io.stdin ~= withOrig.stdin,' -
              'io.lines ~= withOrig.lines' with input stem none.; r = result
  self~assertEquals(.true, r[1])
  self~assertEquals(.true, r[2])
  self~assertEquals(.true, r[3])
  self~assertEquals(.true, r[4])

::method test_normal_replaces_nothing
  address lua 'return print == withOrig.print and io.read == withOrig.read' with input normal output normal error normal; r = result
  self~assertTrue(r)

::method test_read_lines
  in.0 = 3; in.1 = "first"; in.2 = ""; in.3 = "third"
  address lua 'return io.read(), io.read("L"), io.read("*l"), io.read(), io.read()' with input stem in.; r = result
  self~assertEquals(0, rc)
  self~assertSame("first", r[1])
  self~assertEquals('0a'x, r[2], '"L" keeps the line end')
  self~assertSame("third", r[3], 'Lua 5.1''s "*l"')
  self~assertSame(.nil, r[4], "nil at the end")
  self~assertTrue(self~restored)

::method test_read_formats
  in.0 = 3; in.1 = "  12 0x1F -3.5e1 x"; in.2 = "abcdef"; in.3 = "rest"
  address lua 'local a, b, c = io.read("n", "n", "n"); local d = io.read("n");' -
              'return a, b, c, d, io.read(1), io.read(3), io.read(0), io.read("a"), io.read("a"), io.read(0), io.read(2)' -
    with input stem in.; r = result
  self~assertEquals(12, r[1])
  self~assertEquals(31, r[2])
  self~assertEquals(-35, r[3])
  self~assertSame(.nil, r[4], "not a numeral: nil")
  self~assertSame("x", r[5], "a failed number read takes the blank, not the x")
  self~assertEquals('0a'x || "ab", r[6], "counts cross lines")
  self~assertSame("", r[7], '0: "" while there is more')
  self~assertSame("cdef" || '0a'x || "rest" || '0a'x, r[8])
  self~assertSame("", r[9], '"a" at the end: ""')
  self~assertSame(.nil, r[10], "0 at the end: nil")
  self~assertSame(.nil, r[11])

::method test_read_stops_at_the_first_failure
  in.0 = 1; in.1 = "only"
  address lua 'return select("#", io.read("l", "l", "l"))' with input stem in.; r = result
  self~assertEquals(2, r, "one value, then nil, and no more")

::method test_read_invalid_format
  trace off
  call on error name trapped
  in.0 = 1; in.1 = "x"
  address lua 'io.read("x")' with input stem in.
  self~assertEquals(1, rc)
  self~assertTrue(self~additional~pos("invalid format") > 0, self~additional)
  return
trapped:
  self~additional = condition('A')
  return

::method test_empty_input
  in.0 = 0
  address lua 'return io.read()' with input stem in.; r = result
  self~assertSame(.nil, r)
  address lua 'return io.read("a")' with input stem in.; r = result
  self~assertSame("", r)

::method test_lines
  in.0 = 3; in.1 = "a"; in.2 = "b"; in.3 = "c"
  address lua 'for l in io.lines() do print("<" .. l .. ">") end' with input stem in. output stem out.
  self~assertEquals(3, out.0)
  self~assertSame("<a>", out.1)
  self~assertSame("<c>", out.3)
  address lua 'local t = {} for l in io.stdin:lines("L") do t[#t + 1] = l end return table.concat(t, "|")' -
    with input stem in.; r = result
  self~assertSame("a" || '0a'x || "|b" || '0a'x || "|c" || '0a'x, r)
  address lua 'return io.stdin:read("l"), io.stdin:read("a")' with input stem in.; r = result
  self~assertSame("a", r[1])
  self~assertSame("b" || '0a'x || "c" || '0a'x, r[2])

::method test_lines_with_a_file_is_luas
  file = SysTempFileName("withtest???")       -- in the current directory, Lua's too
  call lineout file, "in the file"; call lineout file
  in.0 = 1; in.1 = "redirected"
  .lua~global("_G")["withFile"] = file
  address lua 'for l in io.lines(withFile) do return l end' with input stem in.; r = result
  self~assertSame("in the file", r)
  address lua 'withFile = nil'
  call SysFileDelete file

::method test_input_from_an_array
  address lua 'return io.read("a")' with input using (.array~of("x", "y")); r = result
  self~assertSame("x" || '0a'x || "y" || '0a'x, r)

::method test_input_and_output_together
  in.0 = 2; in.1 = "3"; in.2 = "4"
  address lua 'local s = 0 for l in io.lines() do s = s + tonumber(l) end print(s)' with input stem in. output stem out.
  self~assertEquals(7, out.1)

::method test_stream_methods
  address lua 'local f = io.stdout return f:flush() == f, f:setvbuf("no"), select(2, f:close()), select(2, f:seek()),' -
              'tostring(f), tostring(io.stderr), io.type(f), io.type(withOrig.stdout), io.type(42)' -
    with output stem out. error stem err.; r = result
  self~assertEquals(.true, r[1])
  self~assertEquals(.true, r[2])
  self~assertSame("cannot close standard file", r[3])
  self~assertSame("cannot seek a redirected standard file", r[4])
  self~assertSame("file (ADDRESS LUA output)", r[5])
  self~assertSame("file (ADDRESS LUA error)", r[6])
  self~assertSame("file", r[7], "io.type knows the stand-ins")
  self~assertSame("file", r[8], "and Lua's files")
  self~assertSame(.nil, r[9])

::method test_io_type_of_a_stand_in_whose_command_ended
  address lua 'withKept = io.stdout' with output stem out.
  address lua 'return io.type(withKept)' with output stem out.; r = result
  self~assertSame("closed file", r)
  address lua 'return io.type(withKept)'; r = result
  self~assertSame(.nil, r, "Lua's io.type, outside a command")
  address lua 'withKept = nil'

::method test_io_output_gives_the_stand_in
  address lua 'return io.output() == io.stdout, io.output(io.stdout) == io.stdout, io.write("x") == io.stdout' -
    with output stem out.; r = result
  self~assertEquals(.true, r[1])
  self~assertEquals(.true, r[2])
  self~assertEquals(.true, r[3])
  self~assertSame("x", out.1)

::method test_io_output_to_a_file
  file = SysTempFileName("withtest???")
  .lua~global("_G")["withFile"] = file
  address lua 'io.output(withFile); io.write("to the file\n"); print("printed"); io.output():close();' -
              'io.output(io.stdout); io.write("back\n")' with output stem out.
  self~assertEquals(0, rc)
  self~assertEquals(2, out.0)
  self~assertSame("printed", out.1, "print writes to the standard output")
  self~assertSame("back", out.2)
  self~assertSame("to the file", linein(file))
  call stream file, "c", "close"
  self~assertTrue(self~restored)
  address lua 'return io.output() == io.stdout'; r = result
  self~assertTrue(r, "Lua's default output is the real one again")
  address lua 'withFile = nil'
  call SysFileDelete file

::method test_io_output_to_stderr
  address lua 'io.output(io.stderr); io.write("e\n"); io.output(io.stdout); io.write("o\n")' -
    with output stem out. error stem err.
  self~assertEquals(1, out.0)
  self~assertSame("o", out.1)
  self~assertEquals(1, err.0)
  self~assertSame("e", err.1)
  address lua 'io.output(io.stderr); io.write("only e\n"); io.output(withOrig.stdout)' with error stem err.
  self~assertEquals(1, err.0)
  self~assertSame("only e", err.1)

::method test_io_close
  address lua 'return select(2, io.close(io.stdout)), select(2, io.close())' with output stem out.; r = result
  self~assertSame("cannot close standard file", r[1])
  self~assertSame("cannot close standard file", r[2])

::method test_input_only_keeps_luas_output
  in.0 = 0
  address lua 'return io.write == withOrig.write, io.output == withOrig.output, io.type ~= withOrig.type' -
    with input stem in.; r = result
  self~assertEquals(.true, r[1])
  self~assertEquals(.true, r[2])
  self~assertEquals(.true, r[3])
  self~assertTrue(self~restored)

::method test_a_sandboxed_io_gets_nothing_new
  address lua 'withIo = io; io = {write = withIo.write, stdout = withIo.stdout}'
  address lua 'local k = {} for n in pairs(io) do k[#k + 1] = n end table.sort(k) io.write("w\n")' -
              'return table.concat(k, ",")' with output stem out.; r = result
  address lua 'local same = io.write == withIo.write; io = withIo; withIo = nil; return same'; s = result
  self~assertSame("stdout,write", r)
  self~assertEquals(1, out.0)
  self~assertSame("w", out.1)
  self~assertTrue(s, "restored")

::method test_a_delegated_error_says_where
  trace off
  call on error name trapped
  self~additional = ""
  address lua 'io.output(withOrig.stderr); io.write({})' with output stem out.
  self~assertEquals(1, rc)
  self~assertTrue(self~additional~pos("ADDRESS LUA:1: bad argument #1 to 'write'") > 0, self~additional)
  return
trapped:
  self~additional = condition('A')
  return

::method test_io_input_from_a_file
  file = SysTempFileName("withtest???")
  call lineout file, "in the file"; call lineout file
  in.0 = 1; in.1 = "redirected"
  .lua~global("_G")["withFile"] = file
  address lua 'io.input(withFile); local a = io.read(); local n = 0 for l in io.lines() do n = n + 1 end;' -
              'io.input():close(); local same = io.input(io.stdin) == io.stdin return a, n, io.read(), same' -
    with input stem in.; r = result
  self~assertEquals(0, rc)
  self~assertSame("in the file", r[1])
  self~assertEquals(0, r[2], "io.lines() reads the default input")
  self~assertSame("redirected", r[3])
  self~assertEquals(.true, r[4])
  address lua 'withFile = nil'
  call SysFileDelete file

::method test_a_default_output_set_before_stays
  file = SysTempFileName("withtest???")
  .lua~global("_G")["withFile"] = file
  address lua 'io.output(withFile)'
  address lua 'io.write("to the file\n"); print("printed")' with output stem out.
  address lua 'io.output():close(); io.output(io.stdout)'
  self~assertEquals(1, out.0)
  self~assertSame("printed", out.1)
  self~assertSame("to the file", linein(file), "as a real redirection of the standard output")
  call stream file, "c", "close"
  address lua 'withFile = nil'
  call SysFileDelete file

::method test_restored_after_an_error
  trace off
  call on error name trapped
  address lua 'print("before"); error("boom")' with output stem out.
  self~assertEquals(1, rc)
  self~assertEquals(1, out.0, "what was written stays")
  self~assertSame("before", out.1)
  self~assertTrue(self~restored)
  return
trapped:
  return

::method test_a_change_by_the_command_stays
  address lua 'print = function() return "mine" end' with output stem out.
  address lua 'return print()'; r = result
  self~assertSame("mine", r, "not put back over the command's own")
  address lua 'return io.write == withOrig.write'; r = result
  self~assertTrue(r, "the rest is")

::method test_a_kept_stand_in_fails_after
  trace off
  call on error name trapped
  in.0 = 0
  address lua 'keptPrint, keptRead = print, io.read' with output stem out. input stem in.
  self~assertEquals(0, rc)
  self~additional = ""
  address lua 'keptPrint("late")'
  self~assertEquals(1, rc)
  self~assertTrue(self~additional~pos("has ended") > 0, self~additional)
  self~additional = ""
  address lua 'keptRead()'
  self~assertEquals(1, rc)
  self~assertTrue(self~additional~pos("has ended") > 0, self~additional)
  address lua 'keptPrint, keptRead = nil'
  return
trapped:
  self~additional = condition('A')
  return

::method test_nested_commands
  .lua~global("_G")["withInner"] = .WithInner~new
  address lua 'print("outer 1"); local inner = withInner:run(); print("outer 2"); return inner' with output stem out.; r = result
  self~assertEquals(0, rc)
  self~assertEquals(2, out.0)
  self~assertSame("outer 1", out.1)
  self~assertSame("outer 2", out.2, "the outer redirection again after the inner one")
  self~assertSame("inner", r)
  address lua 'withInner = nil'
  self~assertTrue(self~restored)

::method test_a_rexx_error_of_the_target_is_a_lua_error
  trace off
  call on error name trapped
  self~additional = ""
  address lua 'print("one"); print("two"); return "not reached"' with output using (.FailingTarget~new("never-written"))
  self~assertEquals(1, rc)
  self~assertTrue(self~additional~pos("Rexx error") > 0, self~additional)
  self~assertTrue(self~restored)
  return
trapped:
  self~additional = condition('A')
  return

::method test_rc_and_result_as_without_with
  address lua 'print("x"); return 1, 2' with output stem out.; r = result
  self~assertEquals(0, rc)
  self~assertEquals(2, r~items)
  trace off
  call on failure name trapped
  address lua 'print(' with output stem out.
  self~assertEquals(-1, rc, "does not compile")
  self~assertEquals(0, out.0, "nothing ran")
  self~assertTrue(self~restored)
  return
trapped:
  return

-- an ADDRESS LUA ... WITH of its own, inside a command with output redirected
::class WithInner
::method run
  address lua 'print("inner")' with output stem in.
  return in.1

-- an output target whose writing fails
::class FailingTarget subclass Stream
::method lineout
  raise syntax 93.900 array("this target fails")
